# Ably Realtime (obbligatorio per multi-device)
# Ottieni la chiave gratuita su https://ably.com → Dashboard → API Keys
# NOTA: con prefisso VITE_ la chiave finisce nel bundle JS client-side (normale per app SPA realtime).
VITE_ABLY_KEY=inserisci_qui_la_tua_chiave

# Password console banditore (consigliato in produzione)
VITE_BANDITORE_PASSWORD=carletti

# Firebase (opzionale, non più usato di default)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
